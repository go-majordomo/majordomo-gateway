# =============================================================================
# Server
# =============================================================================
PORT=6560
# HOST=0.0.0.0
# READ_TIMEOUT=30s
# WRITE_TIMEOUT=600s
# UPSTREAM_TIMEOUT=600s
# Max wait for the first upstream byte on streaming requests (0 = no timeout).
# STREAM_HEADER_TIMEOUT=0

# =============================================================================
# Database (required)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=majordomo
POSTGRES_PASSWORD=
POSTGRES_DB=majordomo_gateway
# POSTGRES_SSLMODE=disable
# POSTGRES_MAX_CONNS=20

# =============================================================================
# Admin / query API
# =============================================================================
# Token that guards the /api/v1 admin + usage query API. When set, the CLI and
# MCP server can manage keys and read usage. Leave empty to disable that API and
# serve proxy traffic only. Generate with: openssl rand -hex 32
# ADMIN_TOKEN=

# =============================================================================
# Provider routing (optional) — route a virtual model slug to the cheapest
# healthy provider that can serve it. Off by default. When enabled, the gateway
# stores upstream provider keys AES-256-GCM encrypted in Postgres and injects
# them for routed requests. Manage keys with:
#   gateway-cli provider-keys add|list|remove
# =============================================================================
# 32-byte key (64-char hex or base64) that encrypts stored provider keys at rest.
# Required for provider-key management and routing. Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=
# Turn on routing (requires ENCRYPTION_KEY). Opt in per request with the header
# x-majordomo-provider: majordomo on the OpenAI-compatible surface.
# ROUTING_ENABLED=false
# Default data-handling floor for routed requests — tightened (never relaxed) by
# the per-request X-Majordomo-ZDR / X-Majordomo-Data-Collection headers.
# ROUTING_DEFAULT_REQUIRE_ZDR=false
# ROUTING_DEFAULT_DATA_COLLECTION=            # set "deny" to require no-data-collection endpoints

# =============================================================================
# Logging
# =============================================================================
# LOG_LEVEL=info

# =============================================================================
# Body archival (optional) — store request/response bodies in object storage.
# Credentials come from the cloud SDK's default chain (env AWS_* /
# GOOGLE_APPLICATION_CREDENTIALS or the instance role); the gateway stores none.
# =============================================================================
# BODY_STORAGE=none            # none | s3 | gcs
# BODY_STORAGE_PREFIX=         # optional object key prefix
# --- s3 (or S3-compatible: MinIO, R2) ---
# BODY_S3_BUCKET=
# BODY_S3_REGION=us-east-1
# BODY_S3_ENDPOINT=            # set for S3-compatible stores
# --- gcs ---
# BODY_GCS_BUCKET=
#
# --- AWS credentials (read by the AWS SDK; NOT defined by the gateway) ---
# Only needed for static credentials — on EC2/ECS/EKS the instance/task role is
# used automatically and none of these are required.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                     # only for temporary credentials
# AWS_REGION=us-east-1                   # SDK default region (BODY_S3_REGION overrides for S3)
# AWS_PROFILE=                           # use a named profile from the shared credentials file
# AWS_SHARED_CREDENTIALS_FILE=~/.aws/credentials
# AWS_CONFIG_FILE=~/.aws/config
#
# --- GCS credentials (read by the Google Cloud SDK; NOT defined by the gateway) ---
# Only needed for a service-account key file — on GCE/GKE with workload identity
# or an attached service account, none of these are required.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=                  # project id, if not inferred from the credentials

# =============================================================================
# Provider base URLs (override to route through a local proxy or mock)
# =============================================================================
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference
# TOGETHER_BASE_URL=https://api.together.xyz
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MOONSHOT_BASE_URL=https://api.moonshot.ai
# BASETEN_BASE_URL=https://inference.baseten.co
# NEBIUS_BASE_URL=https://api.studio.nebius.com

# =============================================================================
# Pricing / model catalog (used to compute per-request cost and, when routing is
# enabled, to resolve routable slugs to candidate providers). Remote source is
# refreshed periodically and supplemented by the bundled catalog/alias files.
# =============================================================================
# PRICING_REMOTE_URL=https://www.llm-prices.com/current-v1.json
# PRICING_REFRESH_INTERVAL=1h
# MODEL_CATALOG_FILE=./model_catalog.json
# PRICING_ALIASES_FILE=./model_aliases.json
# DEPRECATED_MODELS_FILE=./deprecated_models.json
